}
@misc{deSwardt2002,
   abstract = {Since the VPI insulation system replaced the old Resin-Rich insulation systems, motor manufacturers could only offer their customers a Class F insulation system. This insulation system is only rated for a maximum temperature of 155 °C. This implies that if the insulation system is subjected to a constant temperature of 155 °C, it will fail after 20000 hours. (2 year, 103 days and 8 hours). This is a far cry from the expected life of a standard electric motor of 20 years! Because of this most motors are sold with a “Class B Temperature Rise”.},
